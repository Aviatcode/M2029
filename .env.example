# ====================================================================
# SyllabusOS Environment Variables Configuration
# ====================================================================

# Port for local Express server (defaults to 3000)
PORT=3000

# Google Gemini API Key for AI features (parsing syllabus, AI tutor, assignment solver)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# Neon Serverless PostgreSQL Database Connection String
# Get your free database at: https://console.neon.tech
# Example format:
DATABASE_URL="postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Optional: Supabase configuration (if using Supabase)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
